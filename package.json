{
  "name": "verify-dependabot-pr",
  "private": true,
  "description": "Securely verify that a pull request is genuinely authored by Dependabot",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js --sourcemap --legal-comments=linked",
    "test": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:acceptance": "jest --selectProjects acceptance",
    "test:live": "scripts/verify_live_prs.sh",
    "test:merge-script": "scripts/verify_merge_script.sh",
    "lint": "eslint .",
    "lint:shell": "uvx --constraints .github/tool-requirements.txt --from shellcheck-py shellcheck scripts/*.sh",
    "lint:workflows": "uvx --constraints .github/tool-requirements.txt --from actionlint-py --with shellcheck-py actionlint",
    "lint:zizmor": "uvx --constraints .github/tool-requirements.txt --from zizmor zizmor .github/workflows action.yml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "all": "npm run lint && npm run lint:shell && npm run lint:workflows && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/plugin-retry": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "jest-cucumber": "^4.5.0",
    "prettier": "^3.10.1",
    "prettier-plugin-gherkin": "^4.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1"
  }
}
